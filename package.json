{
  "name": "dsh-voiceaec",
  "version": "1.0.0",
  "license": "MIT",
  "author": "384615666",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/384615666/VoiceAec-DSH.git"
  },
  "homepage": "https://github.com/384615666/VoiceAec-DSH#readme",
  "keywords": [
    "deepseek-harness",
    "dsh",
    "echo-cancellation",
    "aec",
    "macos",
    "voice-input",
    "audioworklet",
    "plugin"
  ],
  "private": true,
  "description": "VoiceAec echo cancellation for DeepSeek Harness voice input: keep the video playing while you talk",
  "type": "module",
  "icon": "./icon.svg",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "lib/index.js",
    "client.js",
    "cordis.patch.yml",
    "native/voiceaec-tap.swift",
    "native/voiceaec-tap",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "docs/*.md",
    "docs/*.mjs"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  }
}
