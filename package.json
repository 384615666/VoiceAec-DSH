{
  "name": "dsh-voiceaec",
  "version": "0.1.0",
  "private": true,
  "description": "VoiceAec echo cancellation for voice input: talk to DSH while a video keeps playing",
  "type": "module",
  "icon": "./icon.svg",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "lib/index.js",
    "client.js",
    "cordis.patch.yml",
    "native/voiceaec-tap.swift",
    "native/voiceaec-tap",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "docs/*.md",
    "docs/*.mjs"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  }
}
